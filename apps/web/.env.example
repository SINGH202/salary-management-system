# Used by the browser — public API URL
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Used by Next.js server components (SSR) — private hostname on Render
API_INTERNAL_URL="http://localhost:4000"
# Demo gate only — expected in the client bundle; not real auth (see root README later)
NEXT_PUBLIC_DEMO_ACCESS_TOKEN="change-me"
