# Used by the browser — public API URL
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Used by Next.js server components (SSR).
# Local: same as above. On Vercel: set to the public AWS API URL
# (there is no private network between Vercel and EC2).
API_INTERNAL_URL="http://localhost:4000"

# Demo gate only — expected in the client bundle; not real auth.
# Must match apps/api DEMO_ACCESS_TOKEN in every environment.
NEXT_PUBLIC_DEMO_ACCESS_TOKEN="change-me"
