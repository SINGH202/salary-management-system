# Browser API base. Local: API host. On Vercel (HTTPS→HTTP API): leave empty
# so the browser calls same-origin `/api/*` (proxied via next.config rewrites).
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Server-side + rewrite target. Origin only (no trailing slash, no /api).
# Local: same as above. Vercel: http://YOUR_VM_IP (or https://api.example.com).
API_INTERNAL_URL="http://localhost:4000"

# Demo gate only — expected in the client bundle; not real auth.
# Must match apps/api DEMO_ACCESS_TOKEN in every environment.
NEXT_PUBLIC_DEMO_ACCESS_TOKEN="change-me"
