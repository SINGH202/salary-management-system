# Relative to the Prisma schema directory (src/db/prisma/). Resolves to apps/api/dev.db.
# On AWS EC2 use an absolute path on persistent disk, e.g.:
# DATABASE_URL="file:/var/lib/acme/acme.db?connection_limit=1"
DATABASE_URL="file:../../../dev.db?connection_limit=1"
PORT=4000
BASE_CURRENCY=INR
# Browser origin of the Next app (Vercel URL in production; no trailing slash)
CORS_ORIGIN="http://localhost:3000"
DEMO_ACCESS_TOKEN="change-me"
